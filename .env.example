# ==============================================================================
# Trading Journal - Environment Configuration Reference (.env.example)
# ==============================================================================
# Copy this file to `.env` and adjust the variables according to your environment.
# All variables below are documented with their default values and explanations.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE (PostgreSQL)
# ------------------------------------------------------------------------------
POSTGRES_DB=tradejournal
POSTGRES_USER=tradejournal
POSTGRES_PASSWORD=tradejournal
# Connection string used by SQLAlchemy backend
DATABASE_URL=postgresql+psycopg://tradejournal:tradejournal@db:5432/tradejournal

# ------------------------------------------------------------------------------
# 2. APPLICATION ENVIRONMENT & SECURITY
# ------------------------------------------------------------------------------
# Environment: 'development' or 'production'.
# In production, the backend will strictly refuse to start if JWT_SECRET_KEY or
# SEED_ADMIN_PASSWORD use default/weak placeholders.
ENVIRONMENT=development

# Secret key used to sign JWT access tokens (must be >= 32 random characters in production)
JWT_SECRET_KEY=change-me-in-production

# Access token lifetime in minutes (1440 = 24 hours)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Default server and application timezone (IANA format)
APP_TIMEZONE=Europe/Rome

# Default market close cutoff (HH:MM) used for end-of-day calculations
MARKET_CLOSE_CUTOFF=17:30

# Default snapshot execution time (HH:MM) for daily portfolio snapshots
SNAPSHOT_TIME=23:55

# Absolute path for uploaded media and attachments
MEDIA_ROOT=/app/media

# ------------------------------------------------------------------------------
# 3. INITIAL ADMIN SEEDING
# ------------------------------------------------------------------------------
# Automatically seeds an initial administrator user on first boot if no admin exists
SEED_ADMIN_ENABLED=true
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_USERNAME=admin
# Must be changed to a strong password (>= 12 characters) in production
SEED_ADMIN_PASSWORD=password123

# ------------------------------------------------------------------------------
# 4. NETWORKING & CORS
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGINS=http://localhost:15173,http://127.0.0.1:15173

# Frontend Vite API base URL (used during frontend build or client communication)
VITE_API_BASE_URL=http://localhost:18000

# ------------------------------------------------------------------------------
# 5. ASSET ANALYSIS & AI COACHING LLM SETTINGS (Server-level Fallback)
# ------------------------------------------------------------------------------
# Note: Users can configure their own preferred LLM provider, API key, and model
# directly in the application UI (Impostazioni / Settings -> Configurazione AI LLM).
# The variables below serve as global system defaults or server-wide fallbacks.
#
# Supported providers:
#   - gemini     : Google Gemini (generativelanguage.googleapis.com)
#   - openai     : OpenAI (api.openai.com) or compatible endpoints
#   - anthropic  : Anthropic Claude (api.anthropic.com)
#   - ollama     : Local / self-hosted models (via Ollama OpenAI-compatible API)
#   - mock       : Deterministic offline simulation (no API key required)

# Default LLM Provider (default: gemini)
# ANALYSIS_LLM_PROVIDER=gemini

# Model Identifier (enter the exact model name supported by your provider account or server):
# e.g. for Gemini: gemini-2.5-flash, gemini-1.5-pro, etc.
# e.g. for OpenAI: gpt-4o, gpt-4o-mini, etc.
# e.g. for Anthropic: claude-3-5-sonnet, etc.
# e.g. for Ollama: llama3.3, deepseek-r1, etc.
# ANALYSIS_LLM_MODEL=gemini-2.5-flash

# API Key for Google Gemini, OpenAI, or Anthropic.
# (Leave empty if using Ollama or Mock provider)
# ANALYSIS_API_KEY=your-api-key-here

# Base URL for local or custom endpoints:
# For Ollama (default: http://localhost:11434/v1 or http://host.docker.internal:11434/v1 from container)
# For OpenAI-compatible proxies (Groq, OpenRouter, vLLM, LM Studio)
# ANALYSIS_BASE_URL=http://localhost:11434/v1

# Default language for coaching synthesis reports ('it' | 'en')
# ANALYSIS_DEFAULT_LANGUAGE=it
